# ==============================================
# AI Interviewer - Root .gitignore
# ==============================================

# ---- Environment & Secrets (NEVER commit these) ----
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# ---- Node Modules ----
node_modules/
server/node_modules/
client/node_modules/

# ---- Build Outputs ----
client/dist/
client/dist-ssr/

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Uploaded Resume Files (temp, user data) ----
server/uploads/
uploads/

# ---- OS & Editor Files ----
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.idea/
.vscode/*
!.vscode/extensions.json

# ---- Python Virtual Environments ----
.venv/
venv/
__pycache__/
*.pyc

# ---- Misc ----
*.local
coverage/
.nyc_output/
